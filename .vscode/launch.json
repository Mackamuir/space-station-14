{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Client",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Client/Content.Client.dll",
            "args": [],
            "console": "internalConsole",
            "stopAtEntry": false,
            "preLaunchTask": "build"
        },
        {
            "name": "Client (Compatibility renderer)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Client/Content.Client.dll",
            "args": "--cvar display.compat=true",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Server/Content.Server.dll",
            "args": [],
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "preLaunchTask": "build"
        },
        {
            "name": "Client (TTS compound)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Client/Content.Client.dll",
            "args": [
                "--loglevel",
                "tts=Debug"
            ],
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "Server (TTS compound)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Content.Server/Content.Server.dll",
            "args": [
                "--cvar",
                "tts.enabled=true",
                "--cvar",
                "tts.connection_string=localhost:6379",
                "--loglevel",
                "TTSClient=Debug"
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "postDebugTask": "TTS: Stop containers"
        },
        {
            "name": "YAML Linter",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-yaml-linter",
            "program": "${workspaceFolder}/bin/Content.YAMLLinter/Content.YAMLLinter.dll",
            "cwd": "${workspaceFolder}/Content.YAMLLinter",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ],
    "compounds": [
        {
            "name": "Server/Client",
            "configurations": [
                "Server",
                "Client"
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Server/Client + TTS",
            "configurations": [
                "Server (TTS compound)",
                "Client (TTS compound)"
            ],
            "preLaunchTask": "TTS: Prepare debug session",
            "stopAll": true
        }
    ]
}
