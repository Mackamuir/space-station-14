<?xml version="1.0" encoding="UTF-8"?>
<RunSettings>
  <NUnit>
    <MapWarningTo>Failed</MapWarningTo>
    <!-- Don't echo captured test output to the process console. When a shard
         fails the platform replays that console in full (14k lines of pool and
         engine logs); each failure still carries its own output in the report. -->
    <ConsoleOut>0</ConsoleOut>
    <!-- Write the native NUnit result tree before the adapter converts it to
         MTP. The conversion can discard messages from multiple assertions
         when a teardown warning is also present. -->
    <OutputXmlFolderMode>UseResultDirectory</OutputXmlFolderMode>
    <!-- NUnit appends the .xml extension to this base filename. -->
    <TestOutputXmlFileName>test-results</TestOutputXmlFileName>
  </NUnit>
</RunSettings>
